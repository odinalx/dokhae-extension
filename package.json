  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@wxt-dev/module-react": "^1.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wxt": "^0.19.0"
  },
  "overrides": {
    "@wxt-dev/module-react": {
      "@vitejs/plugin-react": "^5.1.0"
